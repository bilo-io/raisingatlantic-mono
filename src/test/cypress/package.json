{
  "name": "cypress-tests",
  "version": "1.0.0",
  "description": "Cypress E2E tests",
  "private": true,
  "scripts": {
    "open": "cypress open",
    "test": "npm run test:prod",
    "test:local": "cypress run --env environment=local",
    "test:dev": "cypress run --env environment=dev",
    "test:test": "cypress run --env environment=staging",
    "test:prod": "cypress run --env environment=prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "axe-core": "^4.10.2",
    "cypress": "^14.5.4",
    "cypress-axe": "^1.6.0",
    "typescript": "^5.7.3"
  }
}
