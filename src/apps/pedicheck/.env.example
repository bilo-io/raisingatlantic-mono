# PediCheck web — environment variables. Copy to `.env.local` for local dev.

# -----------------------------------------------------------------------------
# Backend: Google Apps Script web app (bound to the PediCheck Google Sheet).
# SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix, so these never reach the browser.
# The Next.js route handlers in src/app/api/* proxy to this URL with the token.
# Get both values from the Apps Script setup — see
# docs/PEDICHECK_APPS_SCRIPT_SETUP.md.
# -----------------------------------------------------------------------------
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Optional: override the API base the browser fetches from. Defaults to the
# same-origin route handlers at /api. Only set this if you instead run the
# NestJS API directly (then use its /v1 origin, e.g. http://localhost:3000/v1).
# NEXT_PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# SEO & analytics (Phase 13)
# -----------------------------------------------------------------------------
# Canonical origin used for sitemap.xml, robots.txt, OpenGraph and JSON-LD
# absolute URLs. Defaults to https://pedicheck.co.za when unset.
# NEXT_PUBLIC_SITE_URL=https://pedicheck.co.za

# Plausible analytics (cookieless, POPIA-friendly). The tracking script is only
# emitted when a domain is set, so dev/CI builds stay analytics-free.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pedicheck.co.za
# Optional: override the script source (self-hosted or proxied Plausible).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Google Search Console verification token (renders a <meta> tag when set).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
