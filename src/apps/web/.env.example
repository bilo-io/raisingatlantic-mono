# =============================================================================
# Raising Atlantic Web — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` itself is gitignored.
# =============================================================================

# Base URL of the API (without trailing /v1 — the api-client appends it).
# Local dev:    http://localhost:3000
# Vercel prod:  https://raisingatlantic-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# Toggle the live-API code path. Leave true unless you're using local fixtures.
NEXT_PUBLIC_USE_API=true
