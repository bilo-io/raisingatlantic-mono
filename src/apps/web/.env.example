# =============================================================================
# Raising Atlantic Web — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` itself is gitignored.
# =============================================================================

# Base URL of the API (without trailing /v1 — the api-client appends it).
# Local dev:             http://localhost:3000
# Vercel dev deployment: https://raisingatlantic-api-dev.vercel.app
# Vercel prod deployment: https://raisingatlantic-api.vercel.app
#
# IMPORTANT: this value is baked in at Next.js build time. It MUST be set as a
# Vercel environment variable in the dashboard (Settings → Environment Variables)
# for each project, scoped to the correct environment. Do not rely on this file
# for hosted deployments — changes here have no effect once the image is built.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Toggle the live-API code path. Leave true unless you're using local fixtures.
NEXT_PUBLIC_USE_API=true

# -----------------------------------------------------------------------------
# Cloud Run (GCP) — used when deployed on Cloud Run
# -----------------------------------------------------------------------------
# TODO(GCP): once the Cloud Run API service is provisioned, replace the API URL
# with the Cloud Run service URL from:
#   terraform output -raw api_url   (run from infra/envs/*/
# Example: https://ra-api-prod-XXXX-ew.a.run.app
#
# NEXT_PUBLIC_API_URL=https://ra-api-prod-XXXX-ew.a.run.app

# Internal API URL used by Next.js server-side rendering (SSR) on Cloud Run.
# Points to the API service over the private VPC rather than the public URL.
# TODO(GCP): set to the VPC-internal API address after VPC is provisioned.
# INTERNAL_API_URL=http://ra-api:3000

# -----------------------------------------------------------------------------
# Sentry (error tracking — web)
# -----------------------------------------------------------------------------
# TODO(OPS): replace with web project DSN from Sentry.
# Terraform manages the project resource (infra/envs/*/main.tf → sentry_project.web_*).
# NEXT_PUBLIC_SENTRY_DSN=https://XXXX@oXXXX.ingest.sentry.io/XXXX

NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Upload source maps to Sentry on deploy (set to true in CI).
SENTRY_AUTH_TOKEN=  # TODO(OPS): set in CI from GitHub Secret SENTRY_AUTH_TOKEN
SENTRY_ORG=raising-atlantic
SENTRY_PROJECT=ra-web-dev  # TODO(OPS): match Sentry project slug for the env

# -----------------------------------------------------------------------------
# SEO & analytics (Phase 13)
# -----------------------------------------------------------------------------
# Canonical origin used for sitemap.xml, robots.txt, OpenGraph and JSON-LD
# absolute URLs. Defaults to https://raisingatlantic.com when unset.
# NEXT_PUBLIC_SITE_URL=https://raisingatlantic.com

# Plausible analytics (cookieless, POPIA-friendly). The tracking script is only
# emitted when a domain is set, so dev/CI builds stay analytics-free.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=raisingatlantic.com
# Optional: override the script source (self-hosted or proxied Plausible).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Google Search Console verification token (renders a <meta> tag when set).
# Paste the token from Search Console → Settings → Ownership verification.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
