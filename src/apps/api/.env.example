# =============================================================================
# Raising Atlantic API — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` itself is gitignored.
# =============================================================================

# HTTP port the Nest server binds to.
PORT=3000

# Application environment. Set to `production` on hosted deployments.
NODE_ENV=development

# Extra CORS origins beyond the built-in list (comma-separated, no trailing slash).
# Useful for Vercel preview deployments or custom domains.
# Example: ALLOWED_ORIGINS=https://raisingatlantic-web-dev.vercel.app,https://custom.domain.com
# ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Two ways to configure the DB connection. Use ONE of them:
#
# (A) Hosted (Neon / Vercel-Postgres) — preferred for staging / prod.
#     Just set DATABASE_URL. Vercel's Neon integration injects it automatically.
#     Neon URLs include `?sslmode=require`, which auto-enables SSL.
#
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/raisingatlantic?sslmode=require
#
# (B) Local Docker dev — discrete vars. Used when DATABASE_URL is unset.
#     Matches docker-compose.yml defaults.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=raisingatlantic

# Force SSL even when DATABASE_URL is missing. Leave unset for local Docker.
# DB_SSL=true

# -----------------------------------------------------------------------------
# Cloud SQL (GCP) — used when deployed on Cloud Run
# -----------------------------------------------------------------------------
# TODO(GCP): set these after provisioning Cloud SQL via infra/envs/*/main.tf.
# The connection string format for Cloud SQL Auth Proxy (Cloud Run injects the
# socket automatically via Cloud SQL connections config on the service):
#
# DATABASE_URL=postgresql://ra_app:PASSWORD@localhost/raisingatlantic?host=/cloudsql/ra-prod:africa-south1:ra-postgres-prod
#
# In production, DATABASE_URL is injected from Secret Manager (secret: ra-db-password).
# Never put the production password in this file.

# Cloud SQL instance connection name (PROJECT:REGION:INSTANCE).
# Needed by the Cloud SQL Auth Proxy when running outside Cloud Run.
# CLOUD_SQL_CONNECTION_NAME=ra-prod:africa-south1:ra-postgres-prod  # TODO(GCP): replace with actual connection name

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT secret for signing access tokens. In production, injected from Secret Manager.
# TODO(GCP): create secret "ra-jwt-secret" via: gcloud secrets versions add ra-jwt-secret --data-file=-
JWT_SECRET=CHANGE_ME_USE_SECRET_MANAGER_IN_PROD

# Access token TTL (short-lived). Refresh tokens rotate on use.
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------------
# Sentry (error tracking)
# -----------------------------------------------------------------------------
# TODO(OPS): replace with actual DSN after creating the project in Sentry.
# Terraform manages the project resource (infra/envs/*/main.tf → sentry_project).
# SENTRY_DSN=https://XXXX@oXXXX.ingest.sentry.io/XXXX

# Environment tag sent with every Sentry event.
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Notifications (Phase 8 — see docs/GO_LIVE/DEV.md §8.1 / §8.2 / §8.3)
# -----------------------------------------------------------------------------
# The notification wrapper (src/core/notifications) reads these. The provider
# is selected at runtime by NotificationsModule based on which credentials are
# present. If none are set, the no-op transport is used (logs only, no send).

# --- Email transport ---------------------------------------------------------
# Current default: nodemailer over SMTP (used when SMTP_HOST + SMTP_USER + SMTP_PASS
# are all set). When unset, the no-op email transport runs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="no-reply@raisingatlantic.com"

# TODO(phase-8): choose production email provider — see DEV.md §8.1.
# Candidates (uncomment whichever ships first):
# SENDGRID_API_KEY=SG.XXXX
# POSTMARK_SERVER_TOKEN=
# AWS_SES_REGION=af-south-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# --- SMS / WhatsApp transport ------------------------------------------------
# TODO(phase-8): choose SMS provider — see DEV.md §8.2.
# Candidates: Twilio (international + WhatsApp), Clickatell (SA), Infobip.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+27...
# CLICKATELL_API_KEY=
# INFOBIP_API_KEY=

# --- Mobile push transport ---------------------------------------------------
# Provider decided: Expo Push Notifications — see DEV.md §8.3.
# EXPO_ACCESS_TOKEN required only for server-to-server sends with rate limit
# headers; tokens can be pushed without it.
# EXPO_ACCESS_TOKEN=

# Sender address for any branded transactional template (separate from MAIL_FROM
# which is the envelope sender used by the SMTP transport).
EMAIL_FROM=noreply@raisingatlantic.com

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
# Use TEST keys for local dev and staging. NEVER use live keys outside prod.
# TODO(OPS): replace with Stripe test secret key from dashboard.stripe.com → Developers → API keys.
# STRIPE_SECRET_KEY=sk_test_XXXX

# Webhook secret for verifying Stripe event signatures.
# Get from: dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret.
# TODO(OPS): replace after registering the webhook endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_XXXX

# -----------------------------------------------------------------------------
# GCP project (used by OpenTelemetry / Cloud Logging adapters in core/telemetry)
# -----------------------------------------------------------------------------
# TODO(GCP): replace with actual GCP project ID for the current environment.
# GCP_PROJECT_ID=ra-dev

# GCP region for telemetry resource labels.
GCP_REGION=africa-south1

# -----------------------------------------------------------------------------
# Google Sheets store (PediCheck feature requests + lead capture)
# -----------------------------------------------------------------------------
# Pre-launch marketing data only — NEVER clinical/child data.
# Auth uses Application Default Credentials (the Cloud Run runtime service
# account in prod). The target spreadsheet must be SHARED with that service
# account's email. Locally, run once:
#   gcloud auth application-default login
# No service-account key file is committed or mounted (WIF-only rule).
#
# Spreadsheet id from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
# Provided via GCP Secret Manager in prod.
# GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab names (optional — these are the defaults).
# GOOGLE_SHEETS_FEATURE_TAB=FeatureRequests
# GOOGLE_SHEETS_LEADS_TAB=Leads
