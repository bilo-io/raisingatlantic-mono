{
  "expo": {
    "name": "Raising Atlantic",
    "slug": "raisingatlantic",
    "scheme": "raisingatlantic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/PLACEHOLDER-PROJECT-ID"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raisingatlantic.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:app.raisingatlantic.com"],
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Raising Atlantic uses notifications to remind you about vaccinations, appointments and messages from your care team. No personal information is included in the notification text."
      }
    },
    "android": {
      "package": "com.raisingatlantic.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F1E9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.raisingatlantic.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F1E9"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "raising-atlantic",
          "project": "ra-mobile-prod",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D97757"
        }
      ]
    ],
    "extra": {
      "EXPO_PUBLIC_USE_API": "false",
      "eas": {
        "projectId": "PLACEHOLDER-REPLACE-VIA-eas-init"
      }
    }
  }
}
