EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_VERSION=v1

# ── Build-time only — inject via EAS environment variables, never commit real values ──
# Set these per EAS environment (development / preview / production) with `eas env:create`.
#
# Public Sentry DSN — safe to embed in the JS bundle (client-visible). initSentry() no-ops
# if unset, so leaving it blank in dev disables crash reporting locally.
# EXPO_PUBLIC_SENTRY_DSN=
#
# Sentry auth token for source-map upload during EAS build. BUILD-TIME ONLY.
# MUST NOT carry the EXPO_PUBLIC_ prefix — anything EXPO_PUBLIC_* is bundled client-visible.
# Store as an EAS secret (visibility: secret), read by the @sentry/react-native/expo plugin.
# SENTRY_AUTH_TOKEN=
