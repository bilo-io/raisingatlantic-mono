{
  "name": "@raising-atlantic/clinical",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "clean": "rm -rf node_modules"
  },
  "peerDependencies": {
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@raising-atlantic/types": "file:../types"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": ["ts", "js", "json"],
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "isolatedModules": true, "tsconfig": { "module": "CommonJS", "esModuleInterop": true } }]
    },
    "collectCoverageFrom": ["**/*.ts", "!**/*.spec.ts", "!index.ts"],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": { "lines": 70, "statements": 70, "functions": 70, "branches": 70 }
    }
  }
}
