# Keep CLI uploads small and below Vercel's 100 MB per-file limit.
# The pedicheck Vercel project builds from src/apps/pedicheck (Root
# Directory setting), so local caches and design assets are never needed.
.git
.moon/cache
.moon/docker
**/node_modules
**/.next
**/.next.old
dist
src/apps/pedicheck-assets
